{
  "name": "genshin-crpg-online",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "build": { "command": "python3 ../tools/build_server.py" },
  "limits": { "cpu_ms": 2000 },
  "vars": {
    "ALLOWED_ORIGIN": "https://clannad.shop",
    "ADMIN_ACCOUNT_IDS": ""
  },
  "d1_databases": [{ "binding": "DB", "database_name": "genshin-crpg-online", "database_id": "REPLACE_WITH_CREATED_DATABASE_ID" }]
}

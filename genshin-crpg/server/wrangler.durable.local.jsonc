{
  "name": "genshin-crpg-durable-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "node tools/python.mjs tools/build_server.py"
  },
  "vars": {
    "ALLOWED_ORIGIN": "http://127.0.0.1:4173",
    "GAME_STATE_BACKEND": "do",
    "DO_LOCATION_HINT": "apac-ne",
    "PASSWORD_PEPPER": "local-only-not-a-production-secret-1234567890"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crpg-durable-local",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ACCOUNTS",
        "class_name": "GameAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameAccount"
      ]
    }
  ]
}
